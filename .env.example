APP_ENV=local
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=gsb_salak
DB_SSLMODE=disable

# Falls back to a DSN composed from DB_* above if unset.
MIGRATE_DATABASE_URL=postgres://postgres:example@localhost:5432/gsb_salak?sslmode=disable

JWT_SECRET=change-me-in-prod
JWT_EXPIRY_MINUTES=60

# Set true only for local dev to seed a demo user + demo accounts.
SEED_DEMO_DATA=true
