APP_ENV=local
HTTP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=gsb_salak
DB_SSLMODE=disable

# Falls back to a DSN composed from DB_* above if unset.
MIGRATE_DATABASE_URL=postgres://postgres:example@localhost:5432/gsb_salak?sslmode=disable

JWT_SECRET=change-me-in-prod
JWT_EXPIRY_MINUTES=60

# Admin domain (internal/admin) - its own secret, deliberately never the
# same value as JWT_SECRET. ADMIN_USERNAME/ADMIN_PASSWORD are only read by
# cmd/seed, to create/rotate the seeded admin credential; leaving them unset
# skips admin creation entirely rather than falling back to a guessable
# default.
ADMIN_JWT_SECRET=change-me-in-prod-too
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-prod

# Set true only for local dev to seed a demo user + demo accounts.
SEED_DEMO_DATA=true

# Funds a new user's savings account at registration. Default (committed) is
# 0; set e.g. to 1000000 for a demo so spectators can try the app funded.
# REGISTRATION_SAVINGS_STARTING_BALANCE=1000000

# How long a Kapook goal's auto-purchase countdown runs once its target is
# reached. Default (committed) is 24h, the real product behavior; set e.g. to
# 60s for a demo/test run so the countdown finishes inside a presentation
# instead of a real day. Accepts Go duration syntax (30s, 5m, 24h).
# KAPOOK_COUNTDOWN_DURATION=60s

# How often cmd/worker polls for due Kapook goals. Default (committed) is 1m,
# the real cadence. If you shorten KAPOOK_COUNTDOWN_DURATION for a demo,
# shorten this too - otherwise the countdown can sit at zero for up to a full
# tick before the worker even looks at it.
# KAPOOK_WORKER_TICK_INTERVAL=5s
